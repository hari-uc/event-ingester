{
  "name": "event-ingester",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "server": "bun run server/index.ts",
    "server:dev": "bun --hot run server/index.ts",
    "worker": "bun run worker/index.ts",
    "seed": "bun run scripts/seedMerchants.ts",
    "push": "bun run scripts/pushSample.ts",
    "typecheck": "tsc --noEmit",
    "build:server": "bun build server/index.ts --outfile dist/server.js --target bun --minify",
    "build:worker": "bun build worker/index.ts --outfile dist/worker.js --target bun --minify",
    "build": "bun run build:server && bun run build:worker",
    "start:server": "bun dist/server.js",
    "start:worker": "bun dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "express": "^4.21.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "typescript": "^5.7.2"
  }
}
